# Optional settings for docker-compose.yml and the backup scripts.
# Copy this file to .env and change what you need; anything left out uses the default shown.

# Port the app is served on (always only on 127.0.0.1, this computer).
# MMT_PORT=8080

# Folder on this computer where daily database backups are saved.
# MMT_BACKUP_DIR=${HOME}/MapMyThoughts-backups

# Docker volume that holds the database, and the database name, user and password.
# Change these only before the first start: the database is created with them.
# MMT_DB_VOLUME=mapmythoughts-pgdata
# MMT_DB=mapmythoughts
